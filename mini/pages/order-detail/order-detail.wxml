<view class="container" wx:if="{{order}}">
  <view class="page-heading"><view class="eyebrow">ORDER DETAIL</view><view class="page-heading__title">订单详情</view></view>
  <view class="card summary">
    <text class="status status--{{order.status}}">{{order.status}}</text>
    <view class="order-card__number">订单号 {{order.order_no}}</view>
    <view class="summary__row summary__row--total"><text>订单应付</text><text class="summary__total">¥{{order.payable_amount}}</text></view>
    <view class="muted">请在30分钟付款期限内操作；页面恢复会重新查询状态。</view>
  </view>

  <view class="card">
    <view class="eyebrow">ITEMS</view><view class="section-heading__title">商品明细</view>
    <view wx:for="{{order.items}}" wx:key="order_item_id" class="summary__row"><text>{{item.title}} · {{item.label}}</text><text>× {{item.quantity}}</text></view>
  </view>

  <view class="card">
    <view class="eyebrow">PROGRESS</view><view class="section-heading__title">订单进度</view>
    <view class="timeline"><view wx:for="{{order.events}}" wx:key="type" class="timeline__item"><view>{{item.type}}</view><view>{{item.at}}</view></view></view>
  </view>

  <view wx:if="{{error}}" class="state state--error">{{error}}</view>
  <view wx:if="{{notice}}" class="notice">{{notice}}</view>
  <button wx:if="{{pendingPayment}}" class="primary" disabled="{{busy}}" bindtap="pay">继续确认上次模拟支付</button>
  <block wx:if="{{order.status === 'pending'}}">
    <view class="card"><view class="section-heading__title">模拟支付</view><view class="muted">本次仅演示付款流程，不收取费用。</view></view>
    <view wx:if="{{!pendingPayment}}" class="button-row"><button class="primary" data-outcome="success" disabled="{{busy}}" bindtap="pay">模拟付款成功</button><button class="secondary" data-outcome="failed" disabled="{{busy}}" bindtap="pay">模拟付款失败</button></view>
    <button class="danger" disabled="{{busy}}" bindtap="cancel">取消订单</button>
  </block>
  <button wx:if="{{order.status === 'shipped'}}" class="primary" disabled="{{busy}}" bindtap="receive">确认收货</button>
  <navigator wx:if="{{order.status === 'completed'}}" class="primary" url="/pages/review/review?no={{order.order_no}}">评价商品与查看审核结果</navigator>
  <navigator wx:if="{{order.status === 'completed'}}" class="secondary" url="/pages/support/support">联系客服</navigator>
  <button class="text-button" bindtap="unavailable">订阅订单提醒（待平台配置）</button>
</view>
<view wx:else class="container"><view wx:if="{{loading}}" class="state">正在查询最新订单状态…</view><view wx:else class="state state--error">{{error}}</view></view>
