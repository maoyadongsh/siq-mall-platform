<view class="container">
  <view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{notice}}" class="success">{{notice}}</view>
  <view wx:for="{{rows}}" wx:key="id" class="card"><view>{{item.recipient}} · {{item.phone}}</view><view>{{item.province}}{{item.city}}{{item.district}}{{item.detail}}</view><view wx:if="{{item.is_default}}" class="success">默认地址</view><button wx:else class="secondary" data-item="{{item}}" bindtap="makeDefault">设为默认</button><button class="danger" data-item="{{item}}" bindtap="remove">删除</button></view>
  <view class="card"><view style="font-weight:600">手动填写地址</view><input class="input" data-field="recipient" value="{{form.recipient}}" placeholder="收件人" bindinput="onInput" /><input class="input" data-field="phone" value="{{form.phone}}" placeholder="联系电话" bindinput="onInput" /><input class="input" data-field="province" value="{{form.province}}" placeholder="省份" bindinput="onInput" /><input class="input" data-field="city" value="{{form.city}}" placeholder="城市" bindinput="onInput" /><input class="input" data-field="district" value="{{form.district}}" placeholder="区县" bindinput="onInput" /><input class="input" data-field="detail" value="{{form.detail}}" placeholder="详细地址" bindinput="onInput" /><input class="input" data-field="region_code" value="{{form.region_code}}" placeholder="地区编码（默认杭州西湖330106）" bindinput="onInput" /><button class="primary" disabled="{{busy}}" bindtap="submit">{{busy ? '保存中…' : '保存地址'}}</button><button class="secondary" bindtap="unavailable">使用微信地址（未配置，改用手填）</button></view>
  <view wx:if="{{loading}}">正在读取地址…</view>
</view>
