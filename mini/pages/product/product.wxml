<view class="container" wx:if="{{product}}">
  <image wx:if="{{product.cover_url}}" src="{{product.cover_url}}" mode="widthFix" class="cover" />
  <view class="card"><view class="muted">{{product.category}}</view><view style="font-size:38rpx;font-weight:600">{{product.title}}</view><view class="muted">{{product.description}}</view></view>
  <view class="card"><view>选择规格</view><button wx:for="{{product.skus}}" wx:key="id" data-id="{{item.id}}" bindtap="onSku" class="{{sku.id === item.id ? 'primary' : 'secondary'}}">{{item.label}} · ¥{{item.price}} · {{item.available_stock > 0 ? '有货' : '缺货'}}</button></view>
  <view class="card"><view>数量</view><input class="input" type="number" value="{{quantity}}" bindinput="onQuantity" /></view>
  <view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{notice}}" class="success">{{notice}}</view>
  <button class="primary" disabled="{{!sku.available_stock || busy}}" bindtap="add">{{busy ? '提交中…' : '加入购物车'}}</button>
  <navigator class="secondary" url="/pages/support/support">联系客服</navigator>
  <button class="secondary" open-type="share">分享商品</button>
</view>
<view wx:else class="container"><view wx:if="{{loading}}">正在读取商品…</view><view wx:else class="error">{{error}}<navigator url="/pages/index/index">返回首页</navigator></view></view>
