<view class="container"><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{!loading && !rows.length}}" class="card">暂无订单，去挑选商品吧。</view><navigator wx:for="{{rows}}" wx:key="order_no" url="/pages/order-detail/order-detail?no={{item.order_no}}" class="card"><view>{{item.order_no}}</view><view class="row"><text>{{item.status}}</text><text class="price">¥{{item.payable_amount}}</text></view><view class="muted">{{item.created_at}}</view></navigator><view wx:if="{{loading}}">正在恢复订单…</view></view>
