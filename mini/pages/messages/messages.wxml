<view class="container"><view class="row"><view>未读 {{unread}}</view><button class="secondary" bindtap="readAll">全部已读</button></view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{!loading && !rows.length}}" class="card">暂无消息。</view><view wx:for="{{rows}}" wx:key="id" class="card" data-item="{{item}}" bindtap="open"><view class="muted">{{item.type}} · {{item.created_at}}</view><view style="font-weight:600">{{item.is_read ? '' : '［未读］'}}{{item.title}}</view><view>{{item.body}}</view></view><button wx:if="{{hasMore}}" class="secondary" bindtap="more">加载更早消息</button><view wx:if="{{loading}}">正在读取…</view></view>
