<view class="container"><view wx:if="{{loading}}">正在读取内容…</view><view wx:elif="{{error}}" class="error">{{error}}<navigator url="/pages/index/index">返回首页</navigator></view><view wx:else class="card"><view style="font-size:38rpx;font-weight:600">{{content.revision.title}}</view><block wx:for="{{content.revision.blocks}}" wx:key="index"><view wx:if="{{item.type==='heading'}}" style="font-weight:600">{{item.text}}</view><view wx:elif="{{item.type==='text'}}">{{item.text}}</view><rich-text wx:elif="{{item.type==='rich_text'}}" nodes="{{item.html}}" /><image wx:elif="{{item.type==='image'}}" src="{{item.url}}" mode="widthFix" class="cover" /><view wx:elif="{{item.type==='link' &amp;&amp; item.url.indexOf('/') === 0}}" class="link" data-url="{{item.url}}" bindtap="navigate">{{item.label}}</view><view wx:elif="{{item.type==='link'}}" class="link" data-url="{{item.url}}" bindtap="copyLink">{{item.label}}（外部链接，点击复制）</view></block></view></view>
