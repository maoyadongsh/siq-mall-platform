page {
  background: #f7f6f2;
  color: #242b28;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}
view,
text,
input,
button,
navigator,
scroll-view {
  box-sizing: border-box;
}
.container {
  padding: 28rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
}
.container--with-action {
  padding-bottom: calc(156rpx + env(safe-area-inset-bottom));
}
.card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 1rpx solid #e3e6e0;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 6rpx 24rpx rgba(24, 45, 38, 0.025);
}
.primary,
.secondary,
.danger,
.text-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 28rpx;
  border: 1rpx solid transparent;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.4;
  text-align: center;
  text-decoration: none;
}
.primary {
  color: #fff;
  background: #174c43;
}
.secondary {
  color: #174c43;
  border-color: #d9e2da;
  background: #edf2ed;
}
.danger {
  color: #b42318;
  border-color: #f0d8d4;
  background: #fff5f3;
}
.text-button {
  min-height: 64rpx;
  padding: 0 12rpx;
  color: #65716a;
  background: transparent;
  font-size: 24rpx;
}
button::after {
  border: 0;
}
button + button {
  margin-top: 16rpx;
}
.button-row,
.bottom-bar,
.row {
  display: flex;
  align-items: center;
}
.button-row {
  gap: 16rpx;
}
.button-row > * {
  flex: 1;
  margin-top: 0;
}
.muted {
  color: #65716a;
  font-size: 24rpx;
}
.eyebrow {
  margin-bottom: 12rpx;
  color: #174c43;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
}
.page-heading {
  margin: 12rpx 0 32rpx;
}
.page-heading__title {
  margin-bottom: 8rpx;
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.25;
  letter-spacing: -2rpx;
}
.page-heading__description {
  color: #65716a;
  font-size: 24rpx;
}
.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin: 48rpx 0 24rpx;
}
.section-heading__title {
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: -1rpx;
}
.section-heading__link {
  display: flex;
  align-items: center;
  min-height: 64rpx;
  color: #174c43;
  font-size: 24rpx;
}
.price {
  color: #174c43;
  font-weight: 650;
  font-variant-numeric: tabular-nums;
}
.price__currency {
  margin-right: 4rpx;
  font-size: 22rpx;
  font-weight: 500;
}
.input,
.textarea,
.picker {
  display: block;
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  margin: 16rpx 0;
  padding: 20rpx 22rpx;
  border: 1rpx solid #dfe4de;
  border-radius: 16rpx;
  color: #242b28;
  background: #fff;
  font-size: 30rpx;
}
.textarea {
  min-height: 180rpx;
}
.row {
  justify-content: space-between;
  gap: 20rpx;
}
.link {
  display: inline-flex;
  align-items: center;
  min-height: 64rpx;
  color: #174c43;
  text-decoration: none;
}
.error {
  color: #b42318;
}
.success {
  color: #27644c;
}
.state {
  margin: 24rpx 0;
  padding: 28rpx;
  border: 1rpx solid #e3e6e0;
  border-radius: 20rpx;
  color: #65716a;
  background: rgba(255, 255, 255, 0.68);
  font-size: 25rpx;
  text-align: center;
}
.state--error {
  color: #b42318;
  border-color: #f0d8d4;
  background: #fff7f5;
}
.state .secondary,
.state .primary {
  margin-top: 20rpx;
}
.empty {
  padding: 72rpx 32rpx;
  text-align: center;
}
.empty__mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  margin: 0 auto 28rpx;
  border-radius: 28rpx 28rpx 28rpx 8rpx;
  color: #fff;
  background: #174c43;
  font-size: 40rpx;
}
.empty__title {
  margin-bottom: 12rpx;
  font-size: 34rpx;
  font-weight: 600;
}
.empty__description {
  margin-bottom: 28rpx;
  color: #65716a;
  font-size: 25rpx;
}
.cover {
  display: block;
  width: 100%;
  border-radius: 20rpx;
  background: #efeee8;
}
.hero {
  padding: 44rpx 32rpx;
  border: 1rpx solid rgba(185, 105, 77, 0.1);
  border-radius: 24rpx;
  background: linear-gradient(135deg, #f2ece2, #e9e8de);
}
.hero__eyebrow {
  color: #a85f46;
  font-size: 19rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
}
.hero__title {
  margin: 20rpx 0;
  color: #22352f;
  font-size: 52rpx;
  font-weight: 600;
  line-height: 1.25;
  letter-spacing: -3rpx;
}
.hero__description {
  color: #5c6962;
  font-size: 25rpx;
  line-height: 1.8;
}
.hero__note {
  margin-top: 32rpx;
  padding: 28rpx;
  border-radius: 20rpx;
  color: #fff;
  background: #174c43;
}
.hero__note-title {
  margin-bottom: 8rpx;
  font-size: 32rpx;
  font-weight: 550;
}
.hero__note-description {
  color: rgba(255, 255, 255, 0.7);
  font-size: 23rpx;
}
.search-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 28rpx;
  padding: 8rpx 8rpx 8rpx 22rpx;
  border: 1rpx solid rgba(23, 76, 67, 0.08);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 8rpx 24rpx rgba(24, 45, 38, 0.04);
}
.search-box .input {
  flex: 1;
  min-width: 0;
  min-height: 72rpx;
  margin: 0;
  padding: 12rpx 0;
  border: 0;
  background: transparent;
  font-size: 28rpx;
}
.search-box .primary {
  min-height: 72rpx;
  margin: 0;
  padding: 0 26rpx;
  border-radius: 14rpx;
}
.chip-scroll {
  width: 100%;
  margin: 20rpx -28rpx 0 0;
  white-space: nowrap;
}
.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  margin: 0 12rpx 12rpx 0;
  padding: 0 26rpx;
  border: 1rpx solid #dfe4de;
  border-radius: 40rpx;
  color: #53615a;
  background: rgba(255, 255, 255, 0.65);
  font-size: 24rpx;
  line-height: 1.4;
}
.chip--active {
  color: #fff;
  border-color: #174c43;
  background: #174c43;
}
.chip + .chip,
.button-row button + button,
.bottom-bar button + button {
  margin-top: 0;
}
.announcement-list {
  padding: 0;
}
.announcement-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 88rpx;
  border-top: 1rpx solid #e3e6e0;
  color: #242b28;
  font-size: 26rpx;
}
.product-list {
  display: grid;
  gap: 24rpx;
}
.product-card {
  display: block;
  overflow: hidden;
  border: 1rpx solid #e3e6e0;
  border-radius: 22rpx;
  background: #fff;
}
.product-card__cover {
  width: 100%;
  height: 420rpx;
  border-radius: 0;
  background: #efeee8;
}
.product-card__body {
  padding: 24rpx 26rpx 26rpx;
}
.product-card__category {
  margin-bottom: 6rpx;
  color: #65716a;
  font-size: 21rpx;
}
.product-card__title {
  overflow-wrap: anywhere;
  font-size: 30rpx;
  font-weight: 600;
}
.product-card__footer {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
}
.product-card__action {
  color: #65716a;
  font-size: 22rpx;
}
.service-card {
  padding: 32rpx;
  border-radius: 22rpx;
  color: #fff;
  background: #174c43;
}
.service-card__title {
  margin-bottom: 24rpx;
  font-size: 34rpx;
  font-weight: 550;
}
.service-card__item {
  padding: 18rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.15);
}
.service-card__item-title {
  margin-bottom: 5rpx;
  font-size: 26rpx;
  font-weight: 600;
}
.service-card__item-description {
  color: rgba(255, 255, 255, 0.68);
  font-size: 23rpx;
}
.detail-cover {
  width: calc(100% + 56rpx);
  max-height: 760rpx;
  margin: -28rpx -28rpx 32rpx;
  border-radius: 0 0 24rpx 24rpx;
  background: #efeee8;
}
.detail-title {
  margin: 8rpx 0 16rpx;
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.3;
  letter-spacing: -2rpx;
}
.detail-price {
  margin: 28rpx 0 8rpx;
  color: #174c43;
  font-size: 48rpx;
  font-weight: 650;
  font-variant-numeric: tabular-nums;
}
.detail-stock {
  color: #27644c;
  font-size: 24rpx;
}
.detail-stock--unavailable {
  color: #b42318;
}
.sku-list {
  margin-top: 20rpx;
}
.sku-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 88rpx;
  margin-top: 14rpx;
  padding: 18rpx 22rpx;
  border: 1rpx solid #dfe4de;
  border-radius: 16rpx;
  color: #242b28;
  background: #fff;
  font-size: 26rpx;
  line-height: 1.4;
  text-align: left;
}
.sku-option + .sku-option {
  margin-top: 14rpx;
}
.sku-option--active {
  color: #174c43;
  border-color: #174c43;
  background: #edf2ed;
}
.sku-option__meta {
  margin-left: 20rpx;
  color: #65716a;
  font-size: 22rpx;
}
.quantity-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}
.quantity-field .input {
  width: 180rpx;
  margin: 0;
  text-align: center;
}
.bottom-bar {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  gap: 18rpx;
  min-height: 112rpx;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e3e6e0;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -12rpx 32rpx rgba(24, 45, 38, 0.06);
}
.bottom-bar__info {
  flex: 1;
  min-width: 0;
}
.bottom-bar__label,
.bottom-bar__value {
  display: block;
}
.bottom-bar__label {
  color: #65716a;
  font-size: 20rpx;
}
.bottom-bar__value {
  overflow: hidden;
  color: #174c43;
  font-size: 28rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.bottom-bar .primary {
  min-width: 260rpx;
  margin: 0;
}
.notice {
  margin: 20rpx 0;
  padding: 20rpx 22rpx;
  border-radius: 16rpx;
  color: #174c43;
  background: #eaf2eb;
  font-size: 24rpx;
}
.summary {
  color: #fff;
  background: #174c43;
}
.summary .muted,
.summary .price {
  color: rgba(255, 255, 255, 0.72);
}
.summary .eyebrow,
.service-card .eyebrow {
  color: rgba(255, 255, 255, 0.62);
}
.summary .eyebrow {
  color: rgba(255, 255, 255, 0.62);
}
.summary__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 12rpx 0;
  font-size: 25rpx;
}
.summary__row--total {
  margin-top: 16rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.18);
  font-size: 30rpx;
}
.summary__total {
  color: #fff;
  font-size: 42rpx;
  font-weight: 650;
  font-variant-numeric: tabular-nums;
}
.cart-item__header {
  margin-bottom: 12rpx;
}
.cart-item__title {
  font-size: 29rpx;
  font-weight: 600;
}
.cart-item__meta {
  color: #65716a;
  font-size: 23rpx;
}
.cart-item__actions {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 20rpx;
}
.cart-item__actions .input {
  width: 160rpx;
  margin: 0;
}
.cart-item__actions .text-button {
  margin: 0;
}
.order-card {
  display: block;
}
.order-card__top,
.order-card__bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.order-card__number {
  margin: 20rpx 0;
  overflow-wrap: anywhere;
  font-size: 25rpx;
  font-weight: 550;
}
.order-card__time {
  color: #65716a;
  font-size: 22rpx;
}
.order-card__link {
  color: #174c43;
  font-size: 23rpx;
}
.status {
  display: inline-flex;
  align-items: center;
  min-height: 48rpx;
  padding: 4rpx 16rpx;
  border-radius: 30rpx;
  color: #8a5a18;
  background: #f8f0df;
  font-size: 22rpx;
}
.status--paid,
.status--shipped {
  color: #27644c;
  background: #eaf3ed;
}
.status--completed {
  color: #174c43;
  background: #e8f0eb;
}
.status--canceled {
  color: #65716a;
  background: #efefeb;
}
.timeline {
  margin: 0;
  padding: 0;
  list-style: none;
}
.timeline__item {
  position: relative;
  margin: 0;
  padding: 0 0 28rpx 28rpx;
  border-left: 2rpx solid #dfe4de;
  color: #65716a;
  font-size: 23rpx;
}
.timeline__item::before {
  content: '';
  position: absolute;
  top: 8rpx;
  left: -7rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #174c43;
}
.timeline__item:last-child {
  padding-bottom: 0;
  border-left-color: transparent;
}
@media (prefers-reduced-motion: reduce) {
  .cover,
  .product-card,
  .primary,
  .secondary {
    transition: none;
  }
}
