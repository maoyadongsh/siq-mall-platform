page {
  background: #f7f6f2;
  color: #242b28;
  font-size: 30rpx;
}
.container {
  padding: 28rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));
}
.card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 1rpx solid #e3e6e0;
  border-radius: 20rpx;
  background: #fff;
}
.primary,
.secondary,
.danger {
  min-height: 88rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  line-height: 88rpx;
}
.primary {
  color: #fff;
  background: #174c43;
}
.secondary {
  color: #174c43;
  background: #e8f0eb;
}
.danger {
  color: #8b2c2c;
  background: #fff0f0;
}
.muted {
  color: #65716a;
  font-size: 26rpx;
}
.price {
  color: #174c43;
  font-weight: 600;
}
.input,
.textarea,
.picker {
  display: block;
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  margin: 16rpx 0;
  padding: 18rpx;
  border: 1rpx solid #e3e6e0;
  border-radius: 12rpx;
  background: #fff;
  font-size: 32rpx;
}
.textarea {
  min-height: 180rpx;
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.link {
  color: #174c43;
  text-decoration: underline;
}
.error {
  color: #8b2c2c;
}
.success {
  color: #174c43;
}
.cover {
  width: 100%;
  border-radius: 16rpx;
  background: #e8f0eb;
}
button + button {
  margin-top: 16rpx;
}
