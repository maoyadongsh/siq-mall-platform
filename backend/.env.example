# ===== 基础 =====
# 生产环境必须设置为随机长字符串（>= 50 位），开发环境可留空使用 dev 默认值
DJANGO_SECRET_KEY=
DJANGO_ENV=development
APP_VERSION=1.0.0
ALLOWED_HOSTS=127.0.0.1,localhost
# 允许跨域的前端来源（逗号分隔），走 Vite/Nginx 代理时可留空
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ===== 数据库（MariaDB 11.4，兼容 MySQL 协议）=====
DB_ENGINE=mysql
DB_NAME=mall_db
DB_USER=mall
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306

# 仅用于"无数据库时快速自检"，正式开发/生产请勿使用
# DB_ENGINE=sqlite3
# DB_NAME=dev.sqlite3

# ===== 缓存（Redis 7）=====
REDIS_URL=redis://127.0.0.1:6379/0

# ===== 日志 =====
LOG_LEVEL=INFO

# ===== 推送/邮件等（迭代九使用，当前留空）=====

# 仅隔离的本地演示环境置1。生产配置始终禁用模拟支付。
DEMO_PAYMENT_ENABLED=0
