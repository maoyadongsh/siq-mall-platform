# Ubuntu 24.04 生产环境变量（安装到 /etc/mall/backend.env，权限 600）
# 参考 backend/.env.example，生产必须显式配置 SECRET_KEY 与 ALLOWED_HOSTS

DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=<用 python -c "import secrets;print(secrets.token_urlsafe(64))" 生成>
DJANGO_ENV=production
APP_VERSION=1.1.0
ALLOWED_HOSTS=mall.example.com
CORS_ALLOWED_ORIGINS=https://mall.example.com

DB_ENGINE=mysql
DB_NAME=mall_db
DB_USER=mall
DB_PASSWORD=<生产数据库密码>
DB_HOST=127.0.0.1
DB_PORT=3306

REDIS_URL=redis://:<Redis密码>@127.0.0.1:6379/0
LOG_LEVEL=INFO

MALL_MEDIA_ROOT=/var/lib/mall/media
