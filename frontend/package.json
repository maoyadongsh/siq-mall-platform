{
  "name": "mall-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "gen:api-types": "openapi-typescript ../docs/openapi.yaml -o src/types/api.d.ts",
    "test": "vitest run",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "element-plus": "^2.9.1",
    "pinia": "^3.0.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "openapi-typescript": "^7.13.0",
    "playwright-core": "1.65.0",
    "prettier": "^3.4.2",
    "sass": "^1.83.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.0.0",
    "vitest": "^5.1.0",
    "vue-tsc": "^2.2.12"
  }
}
